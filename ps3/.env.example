# EDUCORE AI - PS3 Environment Configuration
# Copy this file to .env and update values for your environment.

# Application
APP_NAME="EDUCORE AI - PS3 Early Dropout Prediction & Retention Copilot"
APP_ENV=development
APP_VERSION=1.0.0
API_PREFIX=/api/ps3
LOG_LEVEL=INFO

# Database Configuration
# Option 1 (Production / Supabase PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Option 2 (Local PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/educore_ps3
# Option 3 (Local SQLite fallback for quick development without Postgres):
DATABASE_URL=sqlite:///./educore_ps3.db

# Optional Supabase API credentials (if integrating with Supabase REST/Storage in future phases)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# CSV Ingestion Limits
MAX_UPLOAD_MB=10
MAX_VALIDATION_ERRORS_RETURNED=200

# Synthetic Demo Data Settings
# Set to true ONLY in demo/dev environments if you want startup to auto-seed synthetic demo students when DB is empty
AUTO_SEED_SYNTHETIC_DEMO=false
SYNTHETIC_DEMO_RECORD_COUNT=250
SYNTHETIC_RANDOM_SEED=42

# Phase 2 ML Pipeline & Configurable Risk Thresholds
MODEL_ARTIFACTS_DIR=artifacts/models
MIN_TRAINING_SAMPLES=20
DEFAULT_TEST_SIZE=0.2
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=8
RF_RANDOM_STATE=42
RISK_THRESHOLD_MEDIUM=0.35
RISK_THRESHOLD_HIGH=0.70
THRESHOLD_PROFILE=demo_default

# CORS (comma-separated origins; '*' is rejected when APP_ENV=production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Phase 5 Session, Cookie & Security Hardening
SESSION_TTL_MINUTES=60
SESSION_MAX_LIFETIME_HOURS=12
SESSION_COOKIE_NAME=ps3_session
CSRF_COOKIE_NAME=ps3_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=10
DOCS_ENABLED=true
ENABLE_HSTS=false

# Optional Initial Administrator Bootstrap (ONLY used when users table is empty & password is provided; never commit real passwords)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Phase 5 Notifications & SMTP Email Delivery (disabled | smtp | memory_test)
NOTIFICATION_EMAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@educore.local
FOLLOW_UP_APPROACHING_HOURS=24
NOTIFICATION_MAX_RETRIES=3

