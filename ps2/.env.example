# ==========================================
# EDUCORE AI - PS2 ENVIRONMENT CONFIGURATION
# Automated Formative Assessment & Subjective Grading Assistant
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
API_PREFIX=/api/ps2
DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ps2-submissions

# AI / LLM Configuration (For Phase 2 Grading & Fallback Generation)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/ps2
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

